# Anthropic (research + script generation)
ANTHROPIC_API_KEY=

# edge-tts (narration voice) - free, no key needed, just tuning options
TTS_VOICE=en-US-GuyNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz
# Optional: path to a branded static background image (1080x1920 recommended).
# Defaults to assets/payrecon-logo.png if unset; falls back to a plain gray
# background if that file doesn't exist.
BRAND_BACKGROUND_PATH=

# YouTube (upload) - see README for how to obtain these via Google Cloud Console
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PUBLISH_STATUS=private

# LinkedIn (optional - text post only, no video upload in this version)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Set true to generate script + LinkedIn post only, skip render/upload (fast, cheap way to test)
DRY_RUN=false
